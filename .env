
# ==========================================
# CourseVault — Environment Configuration
# ==========================================

# Telegram Bot
BOT_TOKEN=replace_with_your_telegram_bot_token
OWNER_TELEGRAM_ID=123456789

# SQLite Database
# The database file will be created automatically.
SQLITE_DB_PATH=coursevault.db

# Application
APP_ENV=development
LOG_LEVEL=INFO

# AI features (not implemented yet)
AI_ENABLED=false

# FamGateway payments (not implemented yet)
FAMGATEWAY_ENABLED=false
