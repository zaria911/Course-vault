
# ==========================================
# CourseVault — Environment Configuration
# ==========================================

# Telegram Bot
BOT_TOKEN=replace_with_your_real_telegram_bot_token
OWNER_TELEGRAM_ID=123456789

# PostgreSQL Database
# Replace with your actual PostgreSQL connection URL.
DATABASE_URL=postgresql://username:password@hostname:5432/coursevault

# Application
APP_ENV=development
LOG_LEVEL=INFO

# AI features (not implemented yet)
AI_ENABLED=false

# Payments (FamGateway integration not implemented yet)
FAMGATEWAY_ENABLED=false
FAMGATEWAY_API_KEY=replace_when_official_integration_is_ready
FAMGATEWAY_MERCHANT_ID=replace_when_official_integration_is_ready
FAMGATEWAY_WEBHOOK_SECRET=replace_when_official_integration_is_ready
